# Copia este archivo como ".env" y completa los valores. NUNCA subas ".env" a git.
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Supabase -> Project Settings -> Database -> Connection string -> "Session pooler"
# Reemplaza [YOUR-PASSWORD] por la contraseña de la base de datos de tu proyecto.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
